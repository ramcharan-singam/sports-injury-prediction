# PostgreSQL Database Connection URL (Set your private password here)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/sports_injury_db

# MongoDB Connection URL
MONGO_URL=mongodb://localhost:27017/sports_injury_mongo

# JWT Authentication Secret Key
JWT_SECRET_KEY=change_this_to_your_secure_private_secret_key_2026

# Uploads directory
UPLOAD_DIR=uploads
